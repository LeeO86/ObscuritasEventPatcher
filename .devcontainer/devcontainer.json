{
  "name": "Obscuritas Event Patcher",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "postCreateCommand": "git submodule update --init --recursive && npm ci",
  "forwardPorts": [3000],
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "GitHub.vscode-github-actions"
      ]
    }
  }
}
